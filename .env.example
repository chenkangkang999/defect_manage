# defect_manage 环境变量模板
# ---------------------------------------------------------------------------
# 用法: 复制本文件为 .env 后填写。.env 已在 .gitignore 中, 绝不会进 git。
#       settings.py 启动时会读取它(已存在的真实环境变量优先, 不会被覆盖)。
# ---------------------------------------------------------------------------

# Django 密钥 —— 生产必填; 开发环境留空会用一次性随机密钥并打印告警
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# 调试开关: true / false (生产环境务必 false)
DJANGO_DEBUG=true

# 允许访问的主机名, 逗号分隔 (DEBUG=true 时可留空)
DJANGO_ALLOWED_HOSTS=

# 跨域: 开发可 true; 生产改成 false 并配置白名单
DJANGO_CORS_ALLOW_ALL=true

# 界面语言与时区 (想要中文界面就保留下面两行, 默认值是 en-us / UTC)
DJANGO_LANGUAGE_CODE=zh-hans
DJANGO_TIME_ZONE=Asia/Shanghai

# ---------------------------------------------------------------------------
# 预留: 后续接回 LLM 研判功能时使用(当前回退后的代码未读取此键)
# 申请地址: https://platform.deepseek.com/
# ---------------------------------------------------------------------------
# DEEPSEEK_API_KEY=